spring:
  application:
    name: blps
  jersey:
    application-path: /engine-rest
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/blps}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:postgres}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect

springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    enabled: false
  paths-to-match: /api/v1/**

camunda.bpm:
  filter:
    create: All Tasks
  generic-properties:
    properties:
      historyTimeToLive: P180D
  database:
    schema-update: true
  deployment-resource-pattern: classpath*:bpmn/*.bpmn
  webapp:
    index-redirect-enabled: true

blps:
  bootstrap:
    admin-email: ${BOOTSTRAP_ADMIN_EMAIL:}
    admin-password: ${BOOTSTRAP_ADMIN_PASSWORD:}
