{
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## Вакансия по ID",
      "id": "header-query"
    },
    {
      "type": "text",
      "text": "Выберите вакансию и нажмите **Complete** для загрузки. Чтобы выйти — отметьте «Завершить просмотр».",
      "id": "hint"
    },
    {
      "type": "select",
      "key": "vacancyId",
      "label": "Вакансия",
      "validate": {
        "required": true
      },
      "valuesExpression": "=vacancyOptions",
      "id": "field-vacancyId"
    },
    {
      "type": "text",
      "text": "### Результат",
      "id": "header-result"
    },
    {
      "type": "text",
      "text": "=resultSummary",
      "id": "result-body"
    },
    {
      "type": "checkbox",
      "key": "finish",
      "label": "Завершить просмотр",
      "id": "field-finish"
    }
  ],
  "id": "vacancy-view-get"
}
