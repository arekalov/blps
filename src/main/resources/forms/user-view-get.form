{
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## Пользователь",
      "id": "header-query"
    },
    {
      "type": "text",
      "text": "Выберите пользователя и нажмите **Complete** для загрузки. Чтобы выйти — отметьте «Завершить просмотр».",
      "id": "hint"
    },
    {
      "type": "select",
      "key": "targetUserId",
      "label": "Пользователь",
      "validate": {
        "required": true
      },
      "valuesExpression": "=userOptions",
      "id": "field-targetUserId"
    },
    {
      "type": "text",
      "text": "### Результат",
      "id": "header-result"
    },
    {
      "type": "text",
      "text": "=resultSummary",
      "id": "result-body"
    },
    {
      "type": "checkbox",
      "key": "finish",
      "label": "Завершить просмотр",
      "id": "field-finish"
    }
  ],
  "id": "user-view-get"
}
