{
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## Список тарифов",
      "id": "header-query"
    },
    {
      "type": "text",
      "text": "Настройте пагинацию и нажмите **Complete** — список обновится. Чтобы выйти — отметьте «Завершить просмотр».",
      "id": "hint"
    },
    {
      "type": "number",
      "key": "page",
      "label": "Страница (с 0)",
      "defaultValue": 0,
      "id": "field-page"
    },
    {
      "type": "number",
      "key": "size",
      "label": "Размер страницы",
      "defaultValue": 20,
      "id": "field-size"
    },
    {
      "type": "text",
      "text": "### Результат",
      "id": "header-result"
    },
    {
      "type": "text",
      "text": "=resultSummary",
      "id": "result-body"
    },
    {
      "type": "checkbox",
      "key": "finish",
      "label": "Завершить просмотр",
      "id": "field-finish"
    }
  ],
  "id": "tariff-list-get"
}
