{
  "id": "tariff-select-form",
  "schema": {
    "type": "default",
    "components": [
      {
        "type": "text",
        "text": "## Выбор тарифа",
        "id": "header"
      },
      {
        "type": "text",
        "text": "Выберите тариф для публикации вакансии. Тариф определяет срок размещения.",
        "id": "description"
      },
      {
        "type": "select",
        "key": "selectedTariffId",
        "label": "Тариф",
        "validate": {
          "required": true
        },
        "valuesExpression": "=tariffOptions",
        "id": "field-selectedTariffId"
      }
    ],
    "id": "tariff-select-form"
  }
}
