{
  "components": [
    {
      "text": "## Управление тарифами",
      "type": "text",
      "id": "header"
    },
    {
      "label": "Выберите действие",
      "values": [
        {
          "value": "CREATE",
          "label": "Создать новый тариф"
        },
        {
          "value": "EDIT",
          "label": "Редактировать тариф"
        },
        {
          "value": "DELETE",
          "label": "Удалить тариф"
        }
      ],
      "type": "select",
      "key": "tariffAction",
      "validate": {
        "required": true
      },
      "id": "field-tariffAction"
    },
    {
      "label": "ID тарифа (для редактирования/удаления)",
      "type": "textfield",
      "key": "tariffId",
      "id": "field-tariffId"
    }
  ],
  "type": "default",
  "id": "tariff-action-form",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.47.0"
  },
  "schemaVersion": 19
}