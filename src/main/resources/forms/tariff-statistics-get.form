{
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## Статистика тарифа",
      "id": "header-query"
    },
    {
      "type": "text",
      "text": "Выберите тариф и нажмите **Complete** для загрузки. Чтобы выйти — отметьте «Завершить просмотр».",
      "id": "hint"
    },
    {
      "type": "select",
      "key": "tariffId",
      "label": "Тариф",
      "validate": {
        "required": true
      },
      "valuesExpression": "=tariffOptions",
      "id": "field-tariffId"
    },
    {
      "type": "text",
      "text": "### Результат",
      "id": "header-result"
    },
    {
      "type": "text",
      "text": "=resultSummary",
      "id": "result-body"
    },
    {
      "type": "checkbox",
      "key": "finish",
      "label": "Завершить просмотр (иначе Complete загрузит статистику снова)",
      "id": "field-finish"
    }
  ],
  "id": "tariff-statistics-get"
}
