{
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## История использования тарифа",
      "id": "header-query"
    },
    {
      "type": "text",
      "text": "Выберите тариф и нажмите **Complete** для загрузки. Чтобы выйти — отметьте «Завершить просмотр».",
      "id": "hint"
    },
    {
      "type": "select",
      "key": "tariffId",
      "label": "Тариф",
      "validate": {
        "required": true
      },
      "valuesExpression": "=tariffOptions",
      "id": "field-tariffId"
    },
    {
      "type": "number",
      "key": "page",
      "label": "Страница (с 0)",
      "defaultValue": 0,
      "id": "field-page"
    },
    {
      "type": "number",
      "key": "size",
      "label": "Размер страницы",
      "defaultValue": 20,
      "id": "field-size"
    },
    {
      "type": "text",
      "text": "### Результат",
      "id": "header-result"
    },
    {
      "type": "text",
      "text": "=resultSummary",
      "id": "result-body"
    },
    {
      "type": "checkbox",
      "key": "finish",
      "label": "Завершить просмотр (иначе Complete обновит историю с новыми параметрами)",
      "id": "field-finish"
    }
  ],
  "id": "tariff-usage-history-get"
}
