{
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## Tariff Usage History",
      "id": "header-query"
    },
    {
      "type": "textfield",
      "key": "tariffId",
      "label": "ID тарифа (UUID)",
      "validate": {
        "required": true
      },
      "id": "field-tariffId"
    },
    {
      "type": "number",
      "key": "page",
      "label": "Страница (с 0)",
      "defaultValue": 0,
      "id": "field-page"
    },
    {
      "type": "number",
      "key": "size",
      "label": "Размер страницы",
      "defaultValue": 20,
      "id": "field-size"
    },
    {
      "type": "text",
      "text": "### Результат",
      "id": "header-result"
    },
    {
      "type": "text",
      "text": "=resultSummary",
      "id": "result-body"
    },
    {
      "type": "checkbox",
      "key": "refreshSearch",
      "label": "Обновить результат с новыми параметрами",
      "id": "field-refreshSearch"
    }
  ],
  "id": "tariff-usage-history-get"
}
