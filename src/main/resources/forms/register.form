{
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## Регистрация нового пользователя\n\nБез входа в систему. После регистрации войдите в **Tasklist**.",
      "id": "header",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "type": "textfield",
      "key": "email",
      "label": "Email",
      "validate": {
        "required": true,
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "patternMessage": "Введите корректный email"
      },
      "id": "field-email",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "type": "textfield",
      "key": "password",
      "label": "Пароль",
      "validate": {
        "required": true,
        "minLength": 6,
        "maxLength": 100
      },
      "id": "field-password",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "type": "textfield",
      "key": "companyName",
      "label": "Название компании",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "id": "field-companyName",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "type": "text",
      "text": "### Результат",
      "id": "header-result",
      "conditional": {
        "hide": "=not(showResult)"
      }
    },
    {
      "type": "text",
      "text": "=resultSummary",
      "id": "result-body",
      "conditional": {
        "hide": "=not(showResult)"
      }
    }
  ],
  "id": "register-form"
}
