{
  "components": [
    {
      "text": "## Ошибка заполнения",
      "type": "text",
      "id": "process-error-header",
      "conditional": {
        "hide": "=processError != true"
      }
    },
    {
      "label": "Подробности",
      "type": "textarea",
      "key": "errorMessage",
      "readonly": true,
      "id": "field-error-message",
      "conditional": {
        "hide": "=processError != true"
      }
    },
    {
      "text": "## Создание и отправка вакансии на модерацию",
      "type": "text",
      "id": "header-main",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "text": "## Обязательные данные вакансии",
      "type": "text",
      "id": "header-required",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Название вакансии",
      "type": "textfield",
      "key": "title",
      "validate": {
        "required": false,
        "minLength": 1
      },
      "id": "field-title",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Описание вакансии",
      "type": "textarea",
      "key": "description",
      "validate": {
        "required": true,
        "maxLength": 10000
      },
      "id": "field-description",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Требуемый опыт",
      "values": [
        {
          "value": "NO_EXPERIENCE",
          "label": "Без опыта"
        },
        {
          "value": "ONE_TO_THREE",
          "label": "1-3 года"
        },
        {
          "value": "THREE_TO_SIX",
          "label": "3-6 лет"
        },
        {
          "value": "MORE_THAN_SIX",
          "label": "Более 6 лет"
        }
      ],
      "type": "select",
      "key": "experienceLevel",
      "validate": {
        "required": true
      },
      "id": "field-experienceLevel",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Тип занятости",
      "values": [
        {
          "value": "FULL_TIME",
          "label": "Полная занятость"
        },
        {
          "value": "PART_TIME",
          "label": "Частичная занятость"
        },
        {
          "value": "PROJECT",
          "label": "Проектная работа"
        },
        {
          "value": "INTERNSHIP",
          "label": "Стажировка"
        },
        {
          "value": "VOLUNTEER",
          "label": "Волонтёрство"
        }
      ],
      "type": "select",
      "key": "employmentType",
      "validate": {
        "required": true
      },
      "id": "field-employmentType",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Формат работы",
      "values": [
        {
          "value": "OFFICE",
          "label": "Офис"
        },
        {
          "value": "REMOTE",
          "label": "Удалённо"
        },
        {
          "value": "HYBRID",
          "label": "Гибридный"
        }
      ],
      "type": "select",
      "key": "workFormat",
      "validate": {
        "required": true
      },
      "id": "field-workFormat",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Формат трудоустройства",
      "values": [
        {
          "value": "EMPLOYMENT_CONTRACT",
          "label": "Трудовой договор"
        },
        {
          "value": "CIVIL_CONTRACT",
          "label": "ГПХ / договор услуг"
        },
        {
          "value": "SELF_EMPLOYED",
          "label": "Самозанятость"
        }
      ],
      "type": "select",
      "key": "employmentFormat",
      "validate": {
        "required": true
      },
      "id": "field-employmentFormat",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "График работы",
      "values": [
        {
          "value": "NINE_TO_EIGHTEEN",
          "label": "9:00–18:00"
        },
        {
          "value": "TEN_TO_NINETEEN",
          "label": "10:00–19:00"
        },
        {
          "value": "EIGHT_TO_SEVENTEEN",
          "label": "8:00–17:00"
        },
        {
          "value": "FLEXIBLE",
          "label": "Гибкий график"
        },
        {
          "value": "SHIFT",
          "label": "Сменный"
        },
        {
          "value": "REMOTE_FLEXIBLE",
          "label": "Удалённо, гибкий график"
        }
      ],
      "type": "select",
      "key": "workSchedule",
      "validate": {
        "required": true
      },
      "id": "field-workSchedule",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Город",
      "type": "textfield",
      "key": "city",
      "validate": {
        "required": true,
        "maxLength": 100
      },
      "id": "field-city",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Указать дополнительные данные (зарплата, навыки, адрес)",
      "type": "checkbox",
      "key": "fillOptional",
      "id": "field-fillOptional",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "text": "### Дополнительные данные",
      "type": "text",
      "id": "header-optional",
      "conditional": {
        "hide": "=showResult or not(fillOptional)"
      }
    },
    {
      "label": "Зарплата от (руб.)",
      "type": "number",
      "key": "salaryFrom",
      "validate": {
        "min": 0
      },
      "id": "field-salaryFrom",
      "conditional": {
        "hide": "=showResult or not(fillOptional)"
      }
    },
    {
      "label": "Зарплата до (руб.)",
      "type": "number",
      "key": "salaryTo",
      "validate": {
        "min": 0
      },
      "id": "field-salaryTo",
      "conditional": {
        "hide": "=showResult or not(fillOptional)"
      }
    },
    {
      "label": "Навыки (через запятую, например: Java, Kotlin, Spring)",
      "type": "textfield",
      "key": "additionalSkills",
      "id": "field-additionalSkills",
      "conditional": {
        "hide": "=showResult or not(fillOptional)"
      }
    },
    {
      "label": "Адрес офиса",
      "type": "textfield",
      "key": "address",
      "validate": {
        "maxLength": 500
      },
      "id": "field-address",
      "conditional": {
        "hide": "=showResult or not(fillOptional)"
      }
    },
    {
      "label": "Описание компании",
      "type": "textarea",
      "key": "companyDescription",
      "validate": {
        "maxLength": 5000
      },
      "id": "field-companyDescription",
      "conditional": {
        "hide": "=showResult or not(fillOptional)"
      }
    },
    {
      "text": "## Выбор тарифа",
      "type": "text",
      "id": "header-tariff",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "text": "Выберите тариф для публикации вакансии. Тариф определяет срок размещения.",
      "type": "text",
      "id": "description-tariff",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Тариф",
      "type": "select",
      "key": "selectedTariffId",
      "validate": {
        "required": true
      },
      "valuesExpression": "=tariffOptions",
      "id": "field-selectedTariffId",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "text": "### Подтверждение",
      "type": "text",
      "id": "header-confirm",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Подтверждаю корректность данных",
      "type": "checkbox",
      "key": "confirmed",
      "validate": {
        "required": true
      },
      "id": "field-confirmed",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "label": "Создать вакансию и отправить на модерацию",
      "type": "checkbox",
      "key": "submitForModeration",
      "validate": {
        "required": true
      },
      "id": "field-submitForModeration",
      "conditional": {
        "hide": "=showResult"
      }
    },
    {
      "text": "### Результат",
      "type": "text",
      "id": "header-result",
      "conditional": {
        "hide": "=not(showResult)"
      }
    },
    {
      "text": "=resultSummary",
      "type": "text",
      "id": "result-body",
      "conditional": {
        "hide": "=not(showResult)"
      }
    }
  ],
  "type": "default",
  "id": "vacancy-create-form",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.47.0"
  },
  "schemaVersion": 19
}