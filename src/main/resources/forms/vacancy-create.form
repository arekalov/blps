{
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## Обязательные данные вакансии",
      "id": "header-required"
    },
    {
      "type": "textfield",
      "key": "title",
      "label": "Название вакансии",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "id": "field-title"
    },
    {
      "type": "textarea",
      "key": "description",
      "label": "Описание вакансии",
      "validate": {
        "required": true,
        "maxLength": 10000
      },
      "id": "field-description"
    },
    {
      "type": "select",
      "key": "experienceLevel",
      "label": "Требуемый опыт",
      "validate": {
        "required": true
      },
      "values": [
        {
          "value": "NO_EXPERIENCE",
          "label": "Без опыта"
        },
        {
          "value": "ONE_TO_THREE",
          "label": "1-3 года"
        },
        {
          "value": "THREE_TO_SIX",
          "label": "3-6 лет"
        },
        {
          "value": "MORE_THAN_SIX",
          "label": "Более 6 лет"
        }
      ],
      "id": "field-experienceLevel"
    },
    {
      "type": "select",
      "key": "employmentType",
      "label": "Тип занятости",
      "validate": {
        "required": true
      },
      "values": [
        {
          "value": "FULL_TIME",
          "label": "Полная занятость"
        },
        {
          "value": "PART_TIME",
          "label": "Частичная занятость"
        },
        {
          "value": "CONTRACT",
          "label": "Контракт"
        },
        {
          "value": "INTERNSHIP",
          "label": "Стажировка"
        },
        {
          "value": "VOLUNTEER",
          "label": "Волонтёрство"
        }
      ],
      "id": "field-employmentType"
    },
    {
      "type": "select",
      "key": "workFormat",
      "label": "Формат работы",
      "validate": {
        "required": true
      },
      "values": [
        {
          "value": "OFFICE",
          "label": "Офис"
        },
        {
          "value": "REMOTE",
          "label": "Удалённо"
        },
        {
          "value": "HYBRID",
          "label": "Гибридный"
        }
      ],
      "id": "field-workFormat"
    },
    {
      "type": "select",
      "key": "employmentFormat",
      "label": "Формат трудоустройства",
      "validate": {
        "required": true
      },
      "values": [
        {
          "value": "FULL_DAY",
          "label": "Полный день"
        },
        {
          "value": "SHIFT",
          "label": "Сменный"
        },
        {
          "value": "FLEXIBLE",
          "label": "Гибкий"
        },
        {
          "value": "REMOTE_WORK",
          "label": "Удалённая работа"
        }
      ],
      "id": "field-employmentFormat"
    },
    {
      "type": "select",
      "key": "workSchedule",
      "label": "График работы",
      "validate": {
        "required": true
      },
      "values": [
        {
          "value": "FIVE_DAYS",
          "label": "5/2"
        },
        {
          "value": "SIX_DAYS",
          "label": "6/1"
        },
        {
          "value": "SHIFT_SCHEDULE",
          "label": "Сменный"
        },
        {
          "value": "ARBITRARY",
          "label": "Произвольный"
        }
      ],
      "id": "field-workSchedule"
    },
    {
      "type": "textfield",
      "key": "city",
      "label": "Город",
      "validate": {
        "required": true,
        "maxLength": 100
      },
      "id": "field-city"
    },
    {
      "type": "checkbox",
      "key": "fillOptional",
      "label": "Указать дополнительные данные (зарплата, навыки, адрес)",
      "id": "field-fillOptional"
    },
    {
      "type": "text",
      "text": "### Дополнительные данные",
      "id": "header-optional",
      "conditional": {
        "hide": "=not(fillOptional)"
      }
    },
    {
      "type": "number",
      "key": "salaryFrom",
      "label": "Зарплата от (руб.)",
      "validate": {
        "min": 0
      },
      "id": "field-salaryFrom",
      "conditional": {
        "hide": "=not(fillOptional)"
      }
    },
    {
      "type": "number",
      "key": "salaryTo",
      "label": "Зарплата до (руб.)",
      "validate": {
        "min": 0
      },
      "id": "field-salaryTo",
      "conditional": {
        "hide": "=not(fillOptional)"
      }
    },
    {
      "type": "textfield",
      "key": "additionalSkills",
      "label": "Навыки (через запятую, например: Java, Kotlin, Spring)",
      "id": "field-additionalSkills",
      "conditional": {
        "hide": "=not(fillOptional)"
      }
    },
    {
      "type": "textfield",
      "key": "address",
      "label": "Адрес офиса",
      "validate": {
        "maxLength": 500
      },
      "id": "field-address",
      "conditional": {
        "hide": "=not(fillOptional)"
      }
    },
    {
      "type": "textarea",
      "key": "companyDescription",
      "label": "Описание компании",
      "validate": {
        "maxLength": 5000
      },
      "id": "field-companyDescription",
      "conditional": {
        "hide": "=not(fillOptional)"
      }
    },
    {
      "type": "text",
      "text": "## Выбор тарифа",
      "id": "header-tariff"
    },
    {
      "type": "text",
      "text": "Выберите тариф для публикации вакансии. Тариф определяет срок размещения.",
      "id": "description-tariff"
    },
    {
      "type": "select",
      "key": "selectedTariffId",
      "label": "Тариф",
      "validate": {
        "required": true
      },
      "valuesExpression": "=tariffOptions",
      "id": "field-selectedTariffId"
    },
    {
      "type": "text",
      "text": "### Подтверждение",
      "id": "header-confirm"
    },
    {
      "type": "checkbox",
      "key": "confirmed",
      "label": "Подтверждаю корректность данных и создаю вакансию",
      "validate": {
        "required": true
      },
      "id": "field-confirmed"
    }
  ],
  "id": "vacancy-create-form"
}
