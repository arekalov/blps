<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="vacancy-select-tariff-definitions">

  <process id="vacancy-select-tariff" name="[PATCH] Выбрать тариф для вакансии" isExecutable="true"
           camunda:historyTimeToLive="180" camunda:candidateStarterGroups="EMPLOYER,ADMIN">

    <startEvent id="start"><outgoing>flow-0</outgoing></startEvent>

    <serviceTask id="task-set-mode" name="Подготовка"
                 camunda:expression="${execution.setVariable(&#39;pickerMode&#39;, &#39;DRAFT&#39;)}">
      <incoming>flow-0</incoming><outgoing>flow-1</outgoing>
    </serviceTask>

    <serviceTask id="task-picker" name="Черновики"
                 camunda:delegateExpression="${vacancyPickerDelegate}">
      <incoming>flow-1</incoming><outgoing>flow-2</outgoing>
    </serviceTask>

    <userTask id="task-pick" name="Выбрать вакансию"
              camunda:formKey="camunda-forms:deployment:forms/vacancy-picker.form"
              camunda:candidateGroups="EMPLOYER,ADMIN">
      <incoming>flow-2</incoming><outgoing>flow-3</outgoing>
    </userTask>

    <serviceTask id="task-load-tariffs" name="Загрузить тарифы"
                 camunda:delegateExpression="${tariffListDelegate}">
      <incoming>flow-3</incoming><outgoing>flow-4</outgoing>
    </serviceTask>

    <userTask id="task-select" name="Выбрать тариф"
              camunda:formKey="camunda-forms:deployment:forms/tariff-select.form"
              camunda:candidateGroups="EMPLOYER,ADMIN">
      <incoming>flow-4</incoming><outgoing>flow-5</outgoing>
    </userTask>

    <serviceTask id="task-assign" name="Назначить тариф"
                 camunda:delegateExpression="${vacancySelectTariffDelegate}">
      <incoming>flow-5</incoming><outgoing>flow-6</outgoing>
    </serviceTask>

    <userTask id="task-result" name="Результат"
              camunda:formKey="camunda-forms:deployment:forms/result-display.form"
              camunda:candidateGroups="EMPLOYER,ADMIN">
      <incoming>flow-6</incoming><outgoing>flow-7</outgoing>
    </userTask>

    <endEvent id="end"><incoming>flow-7</incoming></endEvent>

    <sequenceFlow id="flow-0" sourceRef="start" targetRef="task-set-mode"/>
    <sequenceFlow id="flow-1" sourceRef="task-set-mode" targetRef="task-picker"/>
    <sequenceFlow id="flow-2" sourceRef="task-picker" targetRef="task-pick"/>
    <sequenceFlow id="flow-3" sourceRef="task-pick" targetRef="task-load-tariffs"/>
    <sequenceFlow id="flow-4" sourceRef="task-load-tariffs" targetRef="task-select"/>
    <sequenceFlow id="flow-5" sourceRef="task-select" targetRef="task-assign"/>
    <sequenceFlow id="flow-6" sourceRef="task-assign" targetRef="task-result"/>
    <sequenceFlow id="flow-7" sourceRef="task-result" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_vacancy-select-tariff">
    <bpmndi:BPMNPlane id="BPMNPlane_vacancy-select-tariff" bpmnElement="vacancy-select-tariff">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><omgdc:Bounds x="152" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-set-mode_di" bpmnElement="task-set-mode"><omgdc:Bounds x="240" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-picker_di" bpmnElement="task-picker"><omgdc:Bounds x="460" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-pick_di" bpmnElement="task-pick"><omgdc:Bounds x="680" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-load-tariffs_di" bpmnElement="task-load-tariffs"><omgdc:Bounds x="900" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-select_di" bpmnElement="task-select"><omgdc:Bounds x="1120" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-assign_di" bpmnElement="task-assign"><omgdc:Bounds x="1340" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-result_di" bpmnElement="task-result"><omgdc:Bounds x="1560" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><omgdc:Bounds x="1780" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-0_di" bpmnElement="flow-0">
        <omgdi:waypoint x="188" y="118"/><omgdi:waypoint x="240" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-1_di" bpmnElement="flow-1">
        <omgdi:waypoint x="400" y="118"/><omgdi:waypoint x="460" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-2_di" bpmnElement="flow-2">
        <omgdi:waypoint x="620" y="118"/><omgdi:waypoint x="680" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-3_di" bpmnElement="flow-3">
        <omgdi:waypoint x="840" y="118"/><omgdi:waypoint x="900" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-4_di" bpmnElement="flow-4">
        <omgdi:waypoint x="1060" y="118"/><omgdi:waypoint x="1120" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-5_di" bpmnElement="flow-5">
        <omgdi:waypoint x="1280" y="118"/><omgdi:waypoint x="1340" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-6_di" bpmnElement="flow-6">
        <omgdi:waypoint x="1500" y="118"/><omgdi:waypoint x="1560" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-7_di" bpmnElement="flow-7">
        <omgdi:waypoint x="1720" y="118"/><omgdi:waypoint x="1780" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
