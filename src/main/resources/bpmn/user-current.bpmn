<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="user-current-definitions">
  <process id="user-current" name="[GET] Текущий пользователь" isExecutable="true" camunda:historyTimeToLive="180" camunda:candidateStarterGroups="EMPLOYER,MODERATOR,ADMIN">

    <startEvent id="start">
      <outgoing>flow-0</outgoing>
    </startEvent>
    <serviceTask id="task-load" name="Загрузить профиль"
                 camunda:delegateExpression="${userCurrentLoadDelegate}">
      <incoming>flow-0</incoming>
      <outgoing>flow-1</outgoing>
    </serviceTask>
    <userTask id="task-result" name="Мой профиль"
              camunda:formKey="camunda-forms:deployment:forms/result-display.form"
              camunda:candidateGroups="EMPLOYER,MODERATOR,ADMIN">
      <incoming>flow-1</incoming>
      <outgoing>flow-2</outgoing>
    </userTask>
    <endEvent id="end">
      <incoming>flow-2</incoming>
    </endEvent>

    <sequenceFlow id="flow-0" sourceRef="start" targetRef="task-load"/>
    <sequenceFlow id="flow-1" sourceRef="task-load" targetRef="task-result"/>
    <sequenceFlow id="flow-2" sourceRef="task-result" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_user-current">
    <bpmndi:BPMNPlane id="BPMNPlane_user-current" bpmnElement="user-current">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><omgdc:Bounds x="152" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-load_di" bpmnElement="task-load"><omgdc:Bounds x="240" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-result_di" bpmnElement="task-result"><omgdc:Bounds x="460" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><omgdc:Bounds x="680" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-0_di" bpmnElement="flow-0">
        <omgdi:waypoint x="188" y="118"/><omgdi:waypoint x="240" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-1_di" bpmnElement="flow-1">
        <omgdi:waypoint x="400" y="118"/><omgdi:waypoint x="460" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-2_di" bpmnElement="flow-2">
        <omgdi:waypoint x="620" y="118"/><omgdi:waypoint x="680" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
