<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="user-current-definitions">
  <process id="user-current" name="[GET] Текущий пользователь" isExecutable="true" camunda:historyTimeToLive="180" camunda:candidateStarterGroups="EMPLOYER,MODERATOR,ADMIN">

    <startEvent id="start">
      <outgoing>flow-start-to-get</outgoing>
    </startEvent>

    <userTask id="task-get" name="Мой профиль"
              camunda:formKey="camunda-forms:deployment:forms/user-current-get.form"
              camunda:candidateGroups="EMPLOYER,MODERATOR,ADMIN">
      <extensionElements>
        <camunda:executionListener event="start" delegateExpression="${userCurrentLoadDelegate}" />
      </extensionElements>
      <incoming>flow-start-to-get</incoming>
      <outgoing>flow-get-to-end</outgoing>
    </userTask>

    <endEvent id="end">
      <incoming>flow-get-to-end</incoming>
    </endEvent>

    <sequenceFlow id="flow-start-to-get" sourceRef="start" targetRef="task-get"/>
    <sequenceFlow id="flow-get-to-end" sourceRef="task-get" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_user-current">
    <bpmndi:BPMNPlane id="BPMNPlane_user-current" bpmnElement="user-current">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><omgdc:Bounds x="152" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-get_di" bpmnElement="task-get"><omgdc:Bounds x="240" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><omgdc:Bounds x="460" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-to-get_di" bpmnElement="flow-start-to-get">
        <omgdi:waypoint x="188" y="118"/><omgdi:waypoint x="240" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-get-to-end_di" bpmnElement="flow-get-to-end">
        <omgdi:waypoint x="400" y="118"/><omgdi:waypoint x="460" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
