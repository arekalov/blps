<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="vacancy-delete-definitions">

  <process id="vacancy-delete" name="[DELETE] Удалить вакансию" isExecutable="true"
           camunda:historyTimeToLive="180" camunda:candidateStarterGroups="EMPLOYER,ADMIN">

    <startEvent id="start">
      <extensionElements>
        <camunda:executionListener event="end" expression="${execution.setVariable(&#39;showResult&#39;, false)}" />
      </extensionElements>
      <outgoing>flow-0</outgoing>
    </startEvent>

    <serviceTask id="task-set-mode" name="Подготовка"
                 camunda:expression="${execution.setVariable(&#39;pickerMode&#39;, &#39;MY&#39;)}">
      <incoming>flow-0</incoming><outgoing>flow-1</outgoing>
    </serviceTask>

    <serviceTask id="task-picker" name="Список вакансий"
                 camunda:delegateExpression="${vacancyPickerDelegate}">
      <incoming>flow-1</incoming><outgoing>flow-2</outgoing>
    </serviceTask>

    <userTask id="task-form" name="Удалить вакансию"
              camunda:formKey="camunda-forms:deployment:forms/vacancy-delete-confirm.form"
              camunda:candidateGroups="EMPLOYER,ADMIN">
      <incoming>flow-2</incoming>
      <incoming>flow-loop</incoming>
      <outgoing>flow-to-gw</outgoing>
    </userTask>

    <exclusiveGateway id="gw-result" name="Результат?">
      <incoming>flow-to-gw</incoming>
      <outgoing>flow-done</outgoing>
      <outgoing>flow-run</outgoing>
    </exclusiveGateway>

    <serviceTask id="task-delete" name="Удалить"
                 camunda:delegateExpression="${vacancyDeleteDelegate}">
      <incoming>flow-run</incoming>
      <outgoing>flow-loop</outgoing>
    </serviceTask>

    <endEvent id="end"><incoming>flow-done</incoming></endEvent>

    <sequenceFlow id="flow-0" sourceRef="start" targetRef="task-set-mode"/>
    <sequenceFlow id="flow-1" sourceRef="task-set-mode" targetRef="task-picker"/>
    <sequenceFlow id="flow-2" sourceRef="task-picker" targetRef="task-form"/>
    <sequenceFlow id="flow-to-gw" sourceRef="task-form" targetRef="gw-result"/>
    <sequenceFlow id="flow-done" sourceRef="gw-result" targetRef="end">
      <conditionExpression xsi:type="tFormalExpression">${showResult == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-run" sourceRef="gw-result" targetRef="task-delete">
      <conditionExpression xsi:type="tFormalExpression">${showResult != true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-loop" sourceRef="task-delete" targetRef="task-form"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_vacancy-delete">
    <bpmndi:BPMNPlane id="BPMNPlane_vacancy-delete" bpmnElement="vacancy-delete">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><omgdc:Bounds x="152" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-set-mode_di" bpmnElement="task-set-mode"><omgdc:Bounds x="240" y="78" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-picker_di" bpmnElement="task-picker"><omgdc:Bounds x="400" y="78" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-form_di" bpmnElement="task-form"><omgdc:Bounds x="560" y="78" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw-result_di" bpmnElement="gw-result" isMarkerVisible="true"><omgdc:Bounds x="745" y="93" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-delete_di" bpmnElement="task-delete"><omgdc:Bounds x="840" y="160" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><omgdc:Bounds x="840" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-0_di" bpmnElement="flow-0">
        <omgdi:waypoint x="188" y="118"/><omgdi:waypoint x="240" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-1_di" bpmnElement="flow-1">
        <omgdi:waypoint x="360" y="118"/><omgdi:waypoint x="400" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-2_di" bpmnElement="flow-2">
        <omgdi:waypoint x="520" y="118"/><omgdi:waypoint x="560" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-to-gw_di" bpmnElement="flow-to-gw">
        <omgdi:waypoint x="700" y="118"/><omgdi:waypoint x="745" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-done_di" bpmnElement="flow-done">
        <omgdi:waypoint x="795" y="118"/><omgdi:waypoint x="840" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-run_di" bpmnElement="flow-run">
        <omgdi:waypoint x="770" y="143"/><omgdi:waypoint x="770" y="200"/><omgdi:waypoint x="900" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-loop_di" bpmnElement="flow-loop">
        <omgdi:waypoint x="900" y="160"/><omgdi:waypoint x="630" y="160"/><omgdi:waypoint x="630" y="158"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
