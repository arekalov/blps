<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="user-management-definitions">

  <process id="user-management" name="[PATCH/DELETE] Управление профилем" isExecutable="true" camunda:historyTimeToLive="180">

    <startEvent id="start" name="Управление пользователями">
      <outgoing>flow-start-to-action</outgoing>
    </startEvent>

    <userTask id="task-choose-action" name="Выбрать действие с профилем"
              camunda:formKey="camunda-forms:deployment:forms/user-action.form"
              camunda:candidateGroups="EMPLOYER,MODERATOR,ADMIN">
      <incoming>flow-start-to-action</incoming>
      <outgoing>flow-action-to-gw</outgoing>
    </userTask>

    <exclusiveGateway id="gw-action" name="Действие?">
      <incoming>flow-action-to-gw</incoming>
      <outgoing>flow-action-edit</outgoing>
      <outgoing>flow-action-delete</outgoing>
    </exclusiveGateway>

    <!-- EDIT branch -->
    <userTask id="task-edit-form" name="Редактировать профиль пользователя"
              camunda:formKey="camunda-forms:deployment:forms/user-edit.form"
              camunda:candidateGroups="EMPLOYER,MODERATOR,ADMIN">
      <incoming>flow-action-edit</incoming>
      <outgoing>flow-edit-form-to-service</outgoing>
    </userTask>

    <serviceTask id="task-edit-service" name="Сохранить изменения профиля"
                 camunda:delegateExpression="${userUpdateDelegate}">
      <incoming>flow-edit-form-to-service</incoming>
      <outgoing>flow-edit-to-end</outgoing>
    </serviceTask>

    <!-- DELETE branch — только ADMIN -->
    <userTask id="task-delete-confirm" name="Подтвердить удаление пользователя (ADMIN)"
              camunda:formKey="camunda-forms:deployment:forms/user-delete.form"
              camunda:candidateGroups="ADMIN">
      <incoming>flow-action-delete</incoming>
      <outgoing>flow-delete-confirm-to-service</outgoing>
    </userTask>

    <serviceTask id="task-delete-service" name="Удалить пользователя"
                 camunda:delegateExpression="${userDeleteDelegate}">
      <incoming>flow-delete-confirm-to-service</incoming>
      <outgoing>flow-delete-to-end</outgoing>
    </serviceTask>

    <endEvent id="end" name="Операция выполнена">
      <incoming>flow-edit-to-end</incoming>
      <incoming>flow-delete-to-end</incoming>
    </endEvent>

    <sequenceFlow id="flow-start-to-action" sourceRef="start" targetRef="task-choose-action"/>
    <sequenceFlow id="flow-action-to-gw" sourceRef="task-choose-action" targetRef="gw-action"/>
    <sequenceFlow id="flow-action-edit" name="редактировать" sourceRef="gw-action" targetRef="task-edit-form">
      <conditionExpression xsi:type="tFormalExpression">${userAction == 'EDIT'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-action-delete" name="удалить (ADMIN)" sourceRef="gw-action" targetRef="task-delete-confirm">
      <conditionExpression xsi:type="tFormalExpression">${userAction == 'DELETE'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-edit-form-to-service" sourceRef="task-edit-form" targetRef="task-edit-service"/>
    <sequenceFlow id="flow-edit-to-end" sourceRef="task-edit-service" targetRef="end"/>
    <sequenceFlow id="flow-delete-confirm-to-service" sourceRef="task-delete-confirm" targetRef="task-delete-service"/>
    <sequenceFlow id="flow-delete-to-end" sourceRef="task-delete-service" targetRef="end"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_user-management">
    <bpmndi:BPMNPlane id="BPMNPlane_user-management" bpmnElement="user-management">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <omgdc:Bounds x="152" y="132" width="36" height="36"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="130" y="175" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-choose-action_di" bpmnElement="task-choose-action">
        <omgdc:Bounds x="240" y="110" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw-action_di" bpmnElement="gw-action" isMarkerVisible="true">
        <omgdc:Bounds x="455" y="125" width="50" height="50"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="460" y="182" width="40" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-edit-form_di" bpmnElement="task-edit-form">
        <omgdc:Bounds x="560" y="60" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-edit-service_di" bpmnElement="task-edit-service">
        <omgdc:Bounds x="780" y="60" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-delete-confirm_di" bpmnElement="task-delete-confirm">
        <omgdc:Bounds x="560" y="200" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-delete-service_di" bpmnElement="task-delete-service">
        <omgdc:Bounds x="780" y="200" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <omgdc:Bounds x="1002" y="132" width="36" height="36"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="980" y="175" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-to-action_di" bpmnElement="flow-start-to-action">
        <omgdi:waypoint x="188" y="150"/><omgdi:waypoint x="240" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-action-to-gw_di" bpmnElement="flow-action-to-gw">
        <omgdi:waypoint x="400" y="150"/><omgdi:waypoint x="455" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-action-edit_di" bpmnElement="flow-action-edit">
        <omgdi:waypoint x="480" y="125"/><omgdi:waypoint x="480" y="100"/><omgdi:waypoint x="560" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-action-delete_di" bpmnElement="flow-action-delete">
        <omgdi:waypoint x="480" y="175"/><omgdi:waypoint x="480" y="240"/><omgdi:waypoint x="560" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-edit-form-to-service_di" bpmnElement="flow-edit-form-to-service">
        <omgdi:waypoint x="720" y="100"/><omgdi:waypoint x="780" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-edit-to-end_di" bpmnElement="flow-edit-to-end">
        <omgdi:waypoint x="940" y="100"/><omgdi:waypoint x="1020" y="100"/><omgdi:waypoint x="1020" y="132"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-delete-confirm-to-service_di" bpmnElement="flow-delete-confirm-to-service">
        <omgdi:waypoint x="720" y="240"/><omgdi:waypoint x="780" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-delete-to-end_di" bpmnElement="flow-delete-to-end">
        <omgdi:waypoint x="940" y="240"/><omgdi:waypoint x="1020" y="240"/><omgdi:waypoint x="1020" y="168"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
