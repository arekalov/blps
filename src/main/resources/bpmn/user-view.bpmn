<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="user-view-definitions">
  <process id="user-view" name="[GET] Пользователь по ID" isExecutable="true" camunda:historyTimeToLive="180" camunda:candidateStarterGroups="ADMIN">

    <startEvent id="start">
      <outgoing>flow-start-to-get</outgoing>
    </startEvent>

    <userTask id="task-get" name="Просмотр пользователя"
              camunda:formKey="camunda-forms:deployment:forms/user-view-get.form">
      <extensionElements>
        <camunda:executionListener event="start" delegateExpression="${userViewLoadDelegate}" />
      </extensionElements>
      <incoming>flow-start-to-get</incoming>
      <incoming>flow-load-to-get</incoming>
      <outgoing>flow-get-to-gw</outgoing>
    </userTask>

    <exclusiveGateway id="gw-refresh" name="Обновить?">
      <incoming>flow-get-to-gw</incoming>
      <outgoing>flow-refresh-yes</outgoing>
      <outgoing>flow-refresh-no</outgoing>
    </exclusiveGateway>

    <serviceTask id="task-load" name="Загрузить пользователя"
                 camunda:delegateExpression="${userViewLoadDelegate}">
      <incoming>flow-refresh-yes</incoming>
      <outgoing>flow-load-to-get</outgoing>
    </serviceTask>

    <endEvent id="end">
      <incoming>flow-refresh-no</incoming>
    </endEvent>

    <sequenceFlow id="flow-start-to-get" sourceRef="start" targetRef="task-get"/>
    <sequenceFlow id="flow-get-to-gw" sourceRef="task-get" targetRef="gw-refresh"/>
    <sequenceFlow id="flow-refresh-yes" name="обновить" sourceRef="gw-refresh" targetRef="task-load">
      <conditionExpression xsi:type="tFormalExpression">${refreshSearch == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-refresh-no" name="готово" sourceRef="gw-refresh" targetRef="end">
      <conditionExpression xsi:type="tFormalExpression">${refreshSearch != true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-load-to-get" sourceRef="task-load" targetRef="task-get"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_user-view">
    <bpmndi:BPMNPlane id="BPMNPlane_user-view" bpmnElement="user-view">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><omgdc:Bounds x="152" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-get_di" bpmnElement="task-get"><omgdc:Bounds x="240" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw-refresh_di" bpmnElement="gw-refresh" isMarkerVisible="true"><omgdc:Bounds x="455" y="93" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-load_di" bpmnElement="task-load"><omgdc:Bounds x="560" y="160" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><omgdc:Bounds x="560" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-to-get_di" bpmnElement="flow-start-to-get">
        <omgdi:waypoint x="188" y="118"/><omgdi:waypoint x="240" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-get-to-gw_di" bpmnElement="flow-get-to-gw">
        <omgdi:waypoint x="400" y="118"/><omgdi:waypoint x="455" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-refresh-yes_di" bpmnElement="flow-refresh-yes">
        <omgdi:waypoint x="480" y="143"/><omgdi:waypoint x="480" y="200"/><omgdi:waypoint x="560" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-refresh-no_di" bpmnElement="flow-refresh-no">
        <omgdi:waypoint x="505" y="118"/><omgdi:waypoint x="560" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-load-to-get_di" bpmnElement="flow-load-to-get">
        <omgdi:waypoint x="640" y="160"/><omgdi:waypoint x="640" y="40"/><omgdi:waypoint x="320" y="40"/><omgdi:waypoint x="320" y="78"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
