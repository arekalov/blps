<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="user-view-definitions">
  <process id="user-view" name="[GET] Пользователь по ID" isExecutable="true" camunda:historyTimeToLive="180" camunda:candidateStarterGroups="ADMIN">

    <startEvent id="start">
      <extensionElements>
        <camunda:executionListener event="end" expression="${execution.setVariable(&#39;finish&#39;, false)}" />
      </extensionElements>
      <outgoing>flow-start-to-options</outgoing>
    </startEvent>

    <serviceTask id="task-load-options" name="Список пользователей"
                 camunda:delegateExpression="${userListOptionsDelegate}">
      <incoming>flow-start-to-options</incoming>
      <outgoing>flow-options-to-get</outgoing>
    </serviceTask>

    <userTask id="task-get" name="Просмотр пользователя"
              camunda:formKey="camunda-forms:deployment:forms/user-view-get.form"
              camunda:candidateGroups="ADMIN">
      <incoming>flow-options-to-get</incoming>
      <incoming>flow-load-to-get</incoming>
      <outgoing>flow-get-to-gw</outgoing>
    </userTask>

    <exclusiveGateway id="gw-finish" name="Завершить?">
      <incoming>flow-get-to-gw</incoming>
      <outgoing>flow-finish-yes</outgoing>
      <outgoing>flow-finish-no</outgoing>
    </exclusiveGateway>

    <serviceTask id="task-load" name="Загрузить пользователя"
                 camunda:delegateExpression="${userViewLoadDelegate}">
      <incoming>flow-finish-no</incoming>
      <outgoing>flow-load-to-get</outgoing>
    </serviceTask>

    <endEvent id="end">
      <incoming>flow-finish-yes</incoming>
    </endEvent>

    <sequenceFlow id="flow-start-to-options" sourceRef="start" targetRef="task-load-options"/>
    <sequenceFlow id="flow-options-to-get" sourceRef="task-load-options" targetRef="task-get"/>
    <sequenceFlow id="flow-get-to-gw" sourceRef="task-get" targetRef="gw-finish"/>
    <sequenceFlow id="flow-finish-yes" name="завершить" sourceRef="gw-finish" targetRef="end">
      <conditionExpression xsi:type="tFormalExpression">${finish == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-finish-no" name="загрузить" sourceRef="gw-finish" targetRef="task-load">
      <conditionExpression xsi:type="tFormalExpression">${finish != true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-load-to-get" sourceRef="task-load" targetRef="task-get"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_user-view">
    <bpmndi:BPMNPlane id="BPMNPlane_user-view" bpmnElement="user-view">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><omgdc:Bounds x="152" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-load-options_di" bpmnElement="task-load-options"><omgdc:Bounds x="240" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-get_di" bpmnElement="task-get"><omgdc:Bounds x="460" y="78" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw-finish_di" bpmnElement="gw-finish" isMarkerVisible="true"><omgdc:Bounds x="675" y="93" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-load_di" bpmnElement="task-load"><omgdc:Bounds x="560" y="160" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><omgdc:Bounds x="780" y="100" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-to-options_di" bpmnElement="flow-start-to-options">
        <omgdi:waypoint x="188" y="118"/><omgdi:waypoint x="240" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-options-to-get_di" bpmnElement="flow-options-to-get">
        <omgdi:waypoint x="400" y="118"/><omgdi:waypoint x="460" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-get-to-gw_di" bpmnElement="flow-get-to-gw">
        <omgdi:waypoint x="620" y="118"/><omgdi:waypoint x="675" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-finish-yes_di" bpmnElement="flow-finish-yes">
        <omgdi:waypoint x="725" y="118"/><omgdi:waypoint x="780" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-finish-no_di" bpmnElement="flow-finish-no">
        <omgdi:waypoint x="700" y="143"/><omgdi:waypoint x="700" y="200"/><omgdi:waypoint x="640" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-load-to-get_di" bpmnElement="flow-load-to-get">
        <omgdi:waypoint x="560" y="160"/><omgdi:waypoint x="540" y="160"/><omgdi:waypoint x="540" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
