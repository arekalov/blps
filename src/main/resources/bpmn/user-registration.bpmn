<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="user-registration-definitions">

  <process id="user-registration" name="[POST] Регистрация пользователя" isExecutable="true" camunda:historyTimeToLive="180">

    <startEvent id="start" name="Начало регистрации">
      <outgoing>flow-start-to-form</outgoing>
    </startEvent>

    <userTask id="task-fill-register" name="Заполнить форму регистрации"
              camunda:formKey="camunda-forms:deployment:forms/register.form">
      <incoming>flow-start-to-form</incoming>
      <outgoing>flow-form-to-register</outgoing>
    </userTask>

    <serviceTask id="task-register-user" name="Зарегистрировать пользователя"
                 camunda:delegateExpression="${registerDelegate}">
      <incoming>flow-form-to-register</incoming>
      <outgoing>flow-register-to-result</outgoing>
    </serviceTask>

    <userTask id="task-result" name="Результат регистрации"
              camunda:formKey="camunda-forms:deployment:forms/result-display.form">
      <incoming>flow-register-to-result</incoming>
      <outgoing>flow-result-to-end</outgoing>
    </userTask>

    <endEvent id="end" name="Пользователь зарегистрирован">
      <incoming>flow-result-to-end</incoming>
    </endEvent>

    <sequenceFlow id="flow-start-to-form" sourceRef="start" targetRef="task-fill-register"/>
    <sequenceFlow id="flow-form-to-register" sourceRef="task-fill-register" targetRef="task-register-user"/>
    <sequenceFlow id="flow-register-to-result" sourceRef="task-register-user" targetRef="task-result"/>
    <sequenceFlow id="flow-result-to-end" sourceRef="task-result" targetRef="end"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_user-registration">
    <bpmndi:BPMNPlane id="BPMNPlane_user-registration" bpmnElement="user-registration">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <omgdc:Bounds x="152" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-fill-register_di" bpmnElement="task-fill-register">
        <omgdc:Bounds x="240" y="60" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-register-user_di" bpmnElement="task-register-user">
        <omgdc:Bounds x="480" y="60" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-result_di" bpmnElement="task-result">
        <omgdc:Bounds x="720" y="60" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <omgdc:Bounds x="932" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-to-form_di" bpmnElement="flow-start-to-form">
        <omgdi:waypoint x="188" y="100"/><omgdi:waypoint x="240" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-form-to-register_di" bpmnElement="flow-form-to-register">
        <omgdi:waypoint x="420" y="100"/><omgdi:waypoint x="480" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-register-to-result_di" bpmnElement="flow-register-to-result">
        <omgdi:waypoint x="660" y="100"/><omgdi:waypoint x="720" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-result-to-end_di" bpmnElement="flow-result-to-end">
        <omgdi:waypoint x="880" y="100"/><omgdi:waypoint x="932" y="100"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
