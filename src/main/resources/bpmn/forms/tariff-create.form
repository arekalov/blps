{
  "schema": {
    "type": "default",
    "components": [
      {
        "type": "text",
        "text": "## Создание нового тарифа",
        "id": "header"
      },
      {
        "type": "textfield",
        "key": "tariffName",
        "label": "Название тарифа",
        "validate": { "required": true, "maxLength": 100 },
        "id": "field-name"
      },
      {
        "type": "number",
        "key": "tariffPrice",
        "label": "Цена (руб.)",
        "validate": { "required": true, "min": 0 },
        "id": "field-price"
      },
      {
        "type": "number",
        "key": "tariffDurationDays",
        "label": "Срок размещения (дней)",
        "validate": { "required": true, "min": 1 },
        "id": "field-durationDays"
      },
      {
        "type": "textarea",
        "key": "tariffDescription",
        "label": "Описание тарифа",
        "validate": { "required": true, "maxLength": 1000 },
        "id": "field-description"
      }
    ],
    "id": "tariff-create-form"
  }
}
