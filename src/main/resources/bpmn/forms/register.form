{
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## Регистрация нового пользователя",
      "id": "header"
    },
    {
      "type": "textfield",
      "key": "email",
      "label": "Email",
      "validate": {
        "required": true,
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "patternMessage": "Введите корректный email"
      },
      "id": "field-email"
    },
    {
      "type": "textfield",
      "key": "password",
      "label": "Пароль",
      "validate": {
        "required": true,
        "minLength": 6,
        "maxLength": 100
      },
      "id": "field-password"
    },
    {
      "type": "textfield",
      "key": "companyName",
      "label": "Название компании",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "id": "field-companyName"
    }
  ],
  "id": "register-form"
}
