<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="vacancy-publication-definitions">

  <process id="vacancy-publication" name="[POST] Создание и отправка на модерацию" isExecutable="true"
           camunda:historyTimeToLive="180" camunda:candidateStarterGroups="EMPLOYER,ADMIN">

    <startEvent id="start" name="Начало">
      <outgoing>flow-start-to-load-tariffs</outgoing>
    </startEvent>

    <serviceTask id="task-load-tariffs" name="Загрузить тарифы"
                 camunda:delegateExpression="${tariffListDelegate}">
      <incoming>flow-start-to-load-tariffs</incoming>
      <outgoing>flow-load-tariffs-to-fill</outgoing>
    </serviceTask>

    <userTask id="task-fill-vacancy" name="Создание вакансии"
              camunda:formKey="camunda-forms:deployment:forms/vacancy-create.form"
              camunda:candidateGroups="EMPLOYER,ADMIN">
      <incoming>flow-load-tariffs-to-fill</incoming>
      <outgoing>flow-fill-to-create</outgoing>
    </userTask>

    <serviceTask id="task-create-vacancy" name="Создать вакансию (черновик)"
                 camunda:delegateExpression="${vacancyCreateDelegate}">
      <incoming>flow-fill-to-create</incoming>
      <outgoing>flow-create-to-publish-task</outgoing>
    </serviceTask>

    <userTask id="task-publish-vacancy" name="Отправить на модерацию"
              camunda:formKey="camunda-forms:deployment:forms/vacancy-publish.form"
              camunda:candidateGroups="EMPLOYER,ADMIN">
      <incoming>flow-create-to-publish-task</incoming>
      <outgoing>flow-publish-task-to-service</outgoing>
    </userTask>

    <serviceTask id="task-submit-moderation" name="Submit for moderation"
                 camunda:delegateExpression="${vacancyPublishDelegate}">
      <incoming>flow-publish-task-to-service</incoming>
      <outgoing>flow-submit-to-result</outgoing>
    </serviceTask>

    <userTask id="task-result" name="Результат"
              camunda:formKey="camunda-forms:deployment:forms/result-display.form"
              camunda:candidateGroups="EMPLOYER,ADMIN">
      <incoming>flow-submit-to-result</incoming>
      <outgoing>flow-result-to-end</outgoing>
    </userTask>

    <endEvent id="end" name="Отправлено на модерацию">
      <incoming>flow-result-to-end</incoming>
    </endEvent>

    <sequenceFlow id="flow-start-to-load-tariffs" sourceRef="start" targetRef="task-load-tariffs"/>
    <sequenceFlow id="flow-load-tariffs-to-fill" sourceRef="task-load-tariffs" targetRef="task-fill-vacancy"/>
    <sequenceFlow id="flow-fill-to-create" sourceRef="task-fill-vacancy" targetRef="task-create-vacancy"/>
    <sequenceFlow id="flow-create-to-publish-task" sourceRef="task-create-vacancy" targetRef="task-publish-vacancy"/>
    <sequenceFlow id="flow-publish-task-to-service" sourceRef="task-publish-vacancy" targetRef="task-submit-moderation"/>
    <sequenceFlow id="flow-submit-to-result" sourceRef="task-submit-moderation" targetRef="task-result"/>
    <sequenceFlow id="flow-result-to-end" sourceRef="task-result" targetRef="end"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_vacancy-publication">
    <bpmndi:BPMNPlane id="BPMNPlane_vacancy-publication" bpmnElement="vacancy-publication">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <omgdc:Bounds x="152" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-load-tariffs_di" bpmnElement="task-load-tariffs">
        <omgdc:Bounds x="240" y="60" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-fill-vacancy_di" bpmnElement="task-fill-vacancy">
        <omgdc:Bounds x="460" y="60" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-create-vacancy_di" bpmnElement="task-create-vacancy">
        <omgdc:Bounds x="680" y="60" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-publish-vacancy_di" bpmnElement="task-publish-vacancy">
        <omgdc:Bounds x="900" y="60" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-submit-moderation_di" bpmnElement="task-submit-moderation">
        <omgdc:Bounds x="1120" y="60" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-result_di" bpmnElement="task-result">
        <omgdc:Bounds x="1340" y="60" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <omgdc:Bounds x="1562" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-to-load-tariffs_di" bpmnElement="flow-start-to-load-tariffs">
        <omgdi:waypoint x="188" y="100"/><omgdi:waypoint x="240" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-load-tariffs-to-fill_di" bpmnElement="flow-load-tariffs-to-fill">
        <omgdi:waypoint x="400" y="100"/><omgdi:waypoint x="460" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-fill-to-create_di" bpmnElement="flow-fill-to-create">
        <omgdi:waypoint x="620" y="100"/><omgdi:waypoint x="680" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-create-to-publish-task_di" bpmnElement="flow-create-to-publish-task">
        <omgdi:waypoint x="840" y="100"/><omgdi:waypoint x="900" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-publish-task-to-service_di" bpmnElement="flow-publish-task-to-service">
        <omgdi:waypoint x="1060" y="100"/><omgdi:waypoint x="1120" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-submit-to-result_di" bpmnElement="flow-submit-to-result">
        <omgdi:waypoint x="1280" y="100"/><omgdi:waypoint x="1340" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-result-to-end_di" bpmnElement="flow-result-to-end">
        <omgdi:waypoint x="1500" y="100"/><omgdi:waypoint x="1562" y="100"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
