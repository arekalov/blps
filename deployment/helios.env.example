# Скопируйте в deployment/helios.env и подставьте пароль от БД STUDS (как в BlpsDS в standalone.xml).
# Файл helios.env в .gitignore — в репозиторий не коммитить.

export STUDS_DB_USER=s409449
export STUDS_DB_PASSWORD=your_studs_password_here
# Схема STUDS совпадает с логином (s409449.users, s409449.act_* …)
export STUDS_DB_SCHEMA=s409449
